# Final Move API server (Bun). Build from the repository root:
#   docker build -f deploy/Dockerfile.server -t final-move-server .
FROM oven/bun:1.3-alpine

WORKDIR /app

# Workspace manifests first so dependency install is cached between code changes.
COPY package.json bun.lock tsconfig.base.json tsconfig.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/chess/package.json packages/chess/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN bun install --frozen-lockfile

# Server code and the workspace packages it imports.
COPY packages/chess packages/chess
COPY packages/shared packages/shared
COPY apps/server apps/server

ENV NODE_ENV=production \
    PORT=3001
EXPOSE 3001

USER bun

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=4 \
  CMD bun -e "fetch('http://127.0.0.1:3001/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["bun", "apps/server/src/index.ts"]
