# Final Move environment. Copy to .env and fill in. Never commit .env.
# Testnet values are shown; docs/deploy.md lists the mainnet values.

# ── Network ───────────────────────────────────────────────────────────────────
NETWORK=testnet                 # testnet | mainnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_WS_URL=                     # optional, unused
ARC_EXPLORER=https://explorer.testnet.arc.io
CIRCLE_CHAIN=ARC-TESTNET        # ARC on mainnet
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ── Circle developer-controlled wallets ───────────────────────────────────────
CIRCLE_API_KEY=
ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
REFEREE_WALLET_ID=
REFEREE_WALLET_ADDRESS=
TREASURY_WALLET_ID=
BOT_WALLET_IDS=                 # five ids, comma-separated, from create-bot-wallets
CIRCLE_WEBHOOK_PUBLIC_KEY_URL=

# ── Contracts (deployments/<chainId>.json) ────────────────────────────────────
LEDGER_ADDRESS=
ESCROW_ADDRESS=
POOL_ADDRESS=
DEPLOY_BLOCK=

# ── Secrets (openssl rand -hex 32 each) ───────────────────────────────────────
SESSION_SECRET=
INTERNAL_SECRET=                # shared with the web app
ADMIN_TOKEN=

# ── Services ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://finalmove:finalmove@localhost:5432/finalmove
REDIS_URL=redis://localhost:6379
PUBLIC_WEB_URL=                 # web app origin, allowed by CORS

# ── Gas top-ups and limits ────────────────────────────────────────────────────
TOPUP_THRESHOLD_USDC=0.10
TOPUP_AMOUNT_USDC=0.25
TOPUP_DAILY_CAP_USDC=25         # use a small value on mainnet, e.g. 5
MAX_GUEST_GAMES_PER_DAY=        # empty = 50 on mainnet, unlimited on testnet; 0 = unlimited

# ── Production API host only (deploy/compose.prod.yaml) ───────────────────────
POSTGRES_PASSWORD=
API_DOMAIN=                     # e.g. api.finalmove.veilap.xyz

# ── Web app (apps/web/.env.local or the web host's settings) ──────────────────
AUTH_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
API_ORIGIN=                     # API base for server-side calls, e.g. https://api.finalmove.veilap.xyz
NEXT_PUBLIC_NETWORK=testnet     # testnet | mainnet
NEXT_PUBLIC_ARC_EXPLORER=       # optional override of the explorer base
NEXT_PUBLIC_API_ORIGIN=         # e.g. https://api.finalmove.veilap.xyz (empty = same origin)
NEXT_PUBLIC_WS_URL=             # e.g. wss://api.finalmove.veilap.xyz (the app appends /ws)

# Public URL of the web app, used for share cards and absolute links (e.g. https://finalmove.example)
NEXT_PUBLIC_SITE_URL=
